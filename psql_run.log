DROP TABLE
********* QUERY **********
CREATE TABLE fruits
(
    entryid     SERIAL       NOT NULL,
    fruit_name  VARCHAR(50)  NOT NULL,
    variety     VARCHAR(50),
    color       VARCHAR(30),
    season      VARCHAR(20),
    rating      SMALLINT DEFAULT 0,
    row_version INTEGER NOT NULL DEFAULT 0,
    rowid       BIGINT GENERATED ALWAYS AS IDENTITY,
    CONSTRAINT pk_fruits PRIMARY KEY (entryid),
    CONSTRAINT uq_fruits_name UNIQUE (fruit_name)   
);
**************************

CREATE TABLE
********* QUERY **********
CREATE TABLE vendors
(
    entryid       SERIAL       NOT NULL,
    vendor_name   VARCHAR(50)  NOT NULL,
    contact_name  VARCHAR(50),
    phone         VARCHAR(20),
    email         VARCHAR(50),
    rowid         BIGINT GENERATED ALWAYS AS IDENTITY,
    CONSTRAINT pk_vendors PRIMARY KEY (entryid),
    CONSTRAINT uq_vendors_name UNIQUE (vendor_name)  
);
**************************

CREATE TABLE
********* QUERY **********
CREATE TABLE fruits_by_vendor
(
    entryid    SERIAL         NOT NULL,
    fruit_id   INTEGER        NOT NULL,
    vendor_id  INTEGER        NOT NULL,
    price      DECIMAL(8,2),
    rowid      BIGINT GENERATED ALWAYS AS IDENTITY,
    CONSTRAINT pk_fruits_by_vendor PRIMARY KEY (entryid),
    CONSTRAINT fk_fbv_fruit
        FOREIGN KEY (fruit_id) REFERENCES fruits(entryid),
    CONSTRAINT fk_fbv_vendor
        FOREIGN KEY (vendor_id) REFERENCES vendors(entryid),
    CONSTRAINT uq_fbv_fruit_vendor UNIQUE (fruit_id, vendor_id) 
);
**************************

CREATE TABLE
********* QUERY **********
CREATE OR REPLACE FUNCTION fn_delete_fruit_cascade() RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    DELETE FROM fruits_by_vendor
        WHERE fruit_id = OLD.entryid;
    RETURN OLD;
END;
$$;
**************************

CREATE FUNCTION
********* QUERY **********
CREATE OR REPLACE FUNCTION fn_update_fruit() RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    -- for a before update this is redundant. Keeping it in the example
    -- to illustrate its use
    IF pg_trigger_depth() > 1 THEN
        RETURN NULL;
    END IF;
    NEW.row_version := OLD.row_version + 1;
    RETURN NEW;
END;
$$;
**************************

CREATE FUNCTION
********* QUERY **********
CREATE TRIGGER trg_fruits_cascade_delete
    AFTER DELETE ON fruits
    
    FOR EACH ROW
        EXECUTE FUNCTION fn_delete_fruit_cascade();
**************************

CREATE TRIGGER
********* QUERY **********
CREATE TRIGGER trg_fruits_update
    BEFORE UPDATE ON fruits
    -- causes infinite recursivity
    -- AFTER UPDATE ON fruits
        
    FOR EACH ROW
        EXECUTE FUNCTION fn_update_fruit();
**************************

