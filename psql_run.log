CREATE OR REPLACE FUNCTION fn_update_fruit() RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    -- for a before update this is redundant. Keeping it in the example
    -- to illustrate its use
    IF pg_trigger_depth() = 0 THEN
        UPDATE fruits SET row_version = row_version + 1
            WHERE entryid = OLD.entryId;
        RETURN NEW.row_version;
    ELSE
        RETURN OLD.row_version;
    END IF;
END;
$$;
